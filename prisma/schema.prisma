// Yayup — employee recognition & rewards platform.
// Conventions: cuid() IDs, string roles, Site (not Center),
// append-only RewardLedger as the wallet source of truth.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  // Load nested relations (feed cards, profiles) in one SQL query with JOINs
  // instead of one round trip to the database per level.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------- Org & people ----------

model Site {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short prefix, e.g. "MAH"
  timezone  String   @default("Europe/Dublin")
  active    Boolean  @default(true)
  users     User[]
  // People who also work here besides their main site (UserSite).
  otherUsers UserSite[]
  createdAt DateTime @default(now())
}

// Extra sites a person works at besides their main one (User.siteId). The main
// site stays on User for display ("Lifeguard · Bishopstown"); everything that
// is limited to a site (site-only polls and questions, site rewards, the
// leaderboard and analytics site filters) counts every site a person has.
model UserSite {
  userId    String
  siteId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, siteId])
  @@index([siteId])
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String
  avatarUrl   String?
  jobTitle    String? // the job in the company, e.g. "Duty Manager", "Lifeguard"
  role        String        @default("staff") // app permission: "staff" | "manager" | "admin" | "operations" | "ceo"
  // Points rank: decides the monthly giving allowance and the most per
  // recognition. Separate from the app role so, e.g., an admin can be a Centre
  // manager. "staff" | "manager" | "centre_manager" | "operations" | "ceo"
  // (lib/ranks.ts).
  pointsRank  String        @default("staff")
  // Nullable so a removed person can be detached from their site: hard-delete
  // is refused by the content FKs below, and a site with users assigned can't
  // be deleted. Detached users are treated as removed everywhere.
  siteId      String?
  site        Site?         @relation(fields: [siteId], references: [id])
  // Further sites they also work at (never includes the main site).
  otherSites  UserSite[]
  // A person can have several managers, and every one of them is a real user.
  // The UserManager join below is the only source of truth: `managers` are the
  // people who manage this user, `reports` the people this user manages.
  managers    UserManager[] @relation("ManagedUser")
  reports     UserManager[] @relation("ManagerUser")
  hireDate    DateTime?
  birthday    DateTime? // store full date; celebrate on month/day
  // Self-service profile customization (bio, status, pronouns, theme colours,
  // earned avatar decoration, pinned recognitions). Free-form JSON validated
  // by lib/profile-custom.ts; null means "all defaults".
  profile     Json?
  active      Boolean       @default(true)
  // Created automatically on their first company Google sign-in and not yet
  // looked at by an admin (role and site were guessed). Cleared when an admin
  // saves them in Admin > Users.
  needsReview Boolean       @default(false)
  createdAt   DateTime      @default(now())

  // Cached wallet balance. Always written inside the same transaction as the
  // ledger row; RewardLedger SUM remains the source of truth (recompute action exists).
  walletBalance Int @default(0)

  // When this person last opened the profile shop / the rewards list. Items
  // listed after that show as "New" (null: they have never looked).
  shopSeenAt    DateTime?
  rewardsSeenAt DateTime?
  /// When they last opened My rewards (claim updates after it get a dot).
  claimsSeenAt  DateTime?
  /// When they finished the first-sign-in app tour (and got the one-off
  /// welcome points). Null: they haven't, so the tour opens for them. Replaying
  /// the tour from the menu never changes it, so the points are paid once.
  onboardedAt   DateTime?

  sentRecognitions     Recognition[]          @relation("Sender")
  receivedRecognitions RecognitionRecipient[]
  reactions            Reaction[]
  comments             Comment[]
  commentReactions     CommentReaction[]
  pollVotes            PollVote[]
  questionAnswers      QuestionAnswer[]
  suggestions          Suggestion[]
  suggestionVotes      SuggestionVote[]
  nominationsMade      Nomination[]           @relation("Nominator")
  nominationsReceived  Nomination[]           @relation("Nominee")
  ledger               RewardLedger[]
  redemptions          Redemption[]
  celebrations         Celebration[]
  auditEvents          AuditEvent[]

  // next-auth adapter relations
  accounts Account[]
  sessions Session[]

  @@index([siteId])
}

/// Who manages whom. A person has zero or more managers, each a real user.
/// Both sides cascade: removing a person drops their rows here rather than
/// leaving a reference that blocks the delete (and so blocks site removal).
model UserManager {
  userId    String
  user      User     @relation("ManagedUser", fields: [userId], references: [id], onDelete: Cascade)
  managerId String
  manager   User     @relation("ManagerUser", fields: [managerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, managerId])
  @@index([managerId])
}

// ---------- Recognition ----------

model Value {
  id           String        @id @default(cuid())
  name         String
  description  String?
  icon         String? // lucide icon name
  color        String? // hex or token
  /// Optional badge artwork uploaded by an admin (Vercel Blob URL); shown in
  /// place of the icon wherever the value appears.
  imageUrl     String?
  order        Int           @default(0)
  active       Boolean       @default(true)
  recognitions Recognition[]
}

model Recognition {
  id         String    @id @default(cuid())
  /// "recognition" (a shout-out: recipients, a value, maybe points) | "post"
  /// (an ordinary feed post by senderId: text and/or pictures, no recipients,
  /// no value, no points) | "poll" (message is the question, pollOptions the
  /// choices) | "question" (message is the question; answers are private to
  /// the sender). Shout-out counts and analytics only count recognitions.
  kind       String    @default("recognition")
  senderId   String
  sender     User      @relation("Sender", fields: [senderId], references: [id])
  valueId    String?
  value      Value?    @relation(fields: [valueId], references: [id])
  message    String
  visibility String    @default("public") // "public" | "private"
  system     Boolean   @default(false) // true = auto/milestone post
  imageUrls  String[] // optional photos/GIFs (Vercel Blob public URLs)
  // Point-multiplier boost applied to this recognition (null | "operations" |
  // "ceo"). Mutually exclusive; the wallet credit is booked to RewardLedger so
  // boostType is just the current display/authorisation state.
  boostType  String?
  boostById  String? // user who applied the current boost
  boostAt    DateTime?
  /// Polls only: when voting stops (null = never closes).
  pollClosesAt    DateTime?
  /// Polls only: true = voters see the results once they have voted;
  /// false = only the person who asked sees them.
  pollShowResults Boolean   @default(true)
  /// Polls and questions: the sites whose people can see it (Site ids).
  /// Empty = everyone. The author and admins always see it.
  audienceSiteIds String[]  @default([])
  createdAt  DateTime  @default(now())

  recipients RecognitionRecipient[]
  reactions  Reaction[]
  comments   Comment[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  answers     QuestionAnswer[]

  @@index([createdAt])
  @@index([senderId, createdAt])
}

/// A choice on a poll post (Recognition kind "poll").
model PollOption {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  label         String
  sortOrder     Int         @default(0)
  votes         PollVote[]

  @@index([recognitionId])
}

/// One vote per person per poll; voting again moves it to another option.
/// Votes are anonymous: only counts are ever shown.
model PollVote {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  optionId      String
  option        PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([recognitionId, userId])
  @@index([optionId])
}

/// A private answer to a question post (Recognition kind "question"). Only
/// the person who asked and the person who answered can ever read it.
model QuestionAnswer {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([recognitionId, userId])
}

model RecognitionRecipient {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  points        Int         @default(0) // redeemable points granted to this recipient

  @@unique([recognitionId, userId])
  @@index([userId])
}

model Reaction {
  id            String      @id @default(cuid())
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  emoji         String
  createdAt     DateTime    @default(now())

  // One reaction per person per recognition — reacting again switches the emoji.
  @@unique([recognitionId, userId])
}

model Comment {
  id            String            @id @default(cuid())
  recognitionId String
  recognition   Recognition       @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  body          String // may be empty when the comment is just a GIF
  gifUrl        String? // a GIPHY GIF picked in the comment box
  // The comment this one replies to. Replies are one level deep, like
  // Instagram: replying to a reply attaches to the same top-level comment.
  parentId      String?
  parent        Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("CommentReplies")
  reactions     CommentReaction[]
  createdAt     DateTime          @default(now())

  @@index([recognitionId, createdAt])
  @@index([parentId])
}

// An emoji reaction on a comment. Same rules as reactions on posts: one per
// person per comment, reacting again with another emoji switches it.
model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// Who is writing a comment right now, for the "Ana is typing…" line. One row
// per person per post, refreshed every few seconds while they type and
// deleted when they send or stop. Rows older than a few seconds are stale and
// ignored. No relations on purpose: the rows are throwaway.
model CommentTyping {
  recognitionId String
  userId        String
  updatedAt     DateTime @default(now())

  @@id([recognitionId, userId])
  @@index([recognitionId, updatedAt])
}

// ---------- Nomination awards ----------

model AwardProgram {
  id               String       @id @default(cuid())
  name             String
  description      String?
  points           Int          @default(0) // awarded to winner on approval
  cadence          String? // "monthly" | "quarterly" | null (ad hoc)
  requiresApproval Boolean      @default(true)
  active           Boolean      @default(true)
  /// Badge look: lucide icon name and hex colour for the gold-rimmed holo
  /// hexagon shown on winners' profiles and in Awards. Null: trophy in gold.
  icon             String?
  color            String?
  nominations      Nomination[]
}

model Nomination {
  id            String       @id @default(cuid())
  programId     String
  program       AwardProgram @relation(fields: [programId], references: [id])
  nominatorId   String
  nominator     User         @relation("Nominator", fields: [nominatorId], references: [id])
  nomineeId     String
  nominee       User         @relation("Nominee", fields: [nomineeId], references: [id])
  justification String
  status        String       @default("pending") // pending | approved | rejected
  reviewedById  String?
  reviewedAt    DateTime?
  pointsAwarded Int          @default(0)
  createdAt     DateTime     @default(now())

  @@index([nomineeId, status])
  @@index([nominatorId])
  @@index([status, createdAt])
}

// ---------- Rewards & wallet ----------

model Reward {
  id               String       @id @default(cuid())
  name             String
  description      String?
  imageUrl         String?
  category         String?
  pointsCost       Int
  type             String       @default("internal") // "internal" | "giftcard" (future adapter)
  fulfilment       String       @default("manual") // "manual" | "auto"
  stock            Int? // null = unlimited
  /// Real cash cost in euro cents (0 for in-house perks). Claims draw on the
  /// company-wide OrgSettings.monthlyRewardBudgetCents.
  euroCostCents    Int          @default(0)
  /// Claims allowed per calendar month (Irish time); null = no monthly limit.
  monthlyStock     Int?
  siteId           String? // null = all sites
  active           Boolean      @default(true)
  /// Position on the staff Rewards page: Admin > Rewards renumbers it when
  /// offerings are dragged. Categories follow their first offering's position.
  sortOrder        Int          @default(0)
  /// Position in the Featured row, set by dragging in Admin > Rewards. Null =
  /// not placed yet: after the placed ones, most urgent label first.
  featuredOrder    Int?
  createdAt        DateTime     @default(now())
  /// When it went on show (created, or shown again after being hidden): newer
  /// than someone's User.rewardsSeenAt means "New" to them.
  listedAt         DateTime     @default(now())
  /// "reward" (redeemed with points) | "discount" (standing staff discount:
  /// always on, never claimed, no points or stock). See lib/reward-promo.ts.
  kind             String       @default("reward")
  /// Discounts: the headline on the card, e.g. "20% off".
  discountText     String?
  /// Shop label: featured | month_only | discounted | last_chance | limited.
  promoTag         String?
  /// Own wording for the label badge; blank uses the preset name.
  promoText        String?
  /// When the label ends (null = until removed). Ending "month_only" or
  /// "last_chance" takes the reward out of the shop.
  promoEndsAt      DateTime?
  /// "Discounted": the usual price, struck through; it comes back when the label ends.
  wasPointsCost    Int?
  /// How long fulfilment takes, shown to staff before claiming, e.g. 5 +
  /// "working_days". Units: hours | days | working_days | weeks. Null = not said.
  /// See lib/fulfilment.ts.
  fulfilmentAmount Int?
  fulfilmentUnit   String?
  redemptions      Redemption[]
}

model Redemption {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  rewardId        String
  reward          Reward    @relation(fields: [rewardId], references: [id])
  pointsCost      Int // captured at redemption time
  euroCostCents   Int       @default(0) // captured at redemption time; counts against the monthly budget
  status          String    @default("requested") // requested | approved ("In progress") | fulfilled | cancelled
  fulfilledById   String?
  fulfilledAt     DateTime?
  notes           String?
  /// When an admin marked it In progress.
  approvedAt      DateTime?
  /// The promise made at claim time ("Within 5 working days") and the moment
  /// it falls due. Kept on the claim so editing the reward doesn't move it.
  fulfilmentLabel String?
  expectedBy      DateTime?
  /// What the admin tells the person, e.g. "Collect it from reception". Shown in My rewards.
  staffNote       String?
  /// Last time an admin moved it on or changed the note; newer than the
  /// person\'s User.claimsSeenAt puts a dot on My rewards.
  statusChangedAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([rewardId])
}

/// Append-only. Wallet balance = SUM(amount) for a user. Never mutate/delete rows.
model RewardLedger {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int // signed: + earned, - spent
  type       String // RECOGNITION | AWARD | REDEMPTION | EXPIRY | ADJUSTMENT | ...
  sourceType String? // "recognition_recipient" | "nomination" | "redemption" | "year_end" (sourceId = the year)
  sourceId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Profile Store catalogue (Admin > Store). Built-in items keep fixed ids such
/// as "frame-neon" because User.profile.owned stores ids; admin-added items
/// get a cuid. Hide items instead of deleting them once anyone owns one.
model Cosmetic {
  id         String            @id @default(cuid())
  kind       String // "frame" | "banner" | "theme"
  name       String
  price      Int               @default(1) // points; 0 = free, but still claimed in the shop
  rarity     String            @default("common") // common | rare | epic | legendary
  /// Frame: built-in CSS class. Banner: CSS background. Theme: #rrggbb.
  style      String?
  /// Uploaded picture (Vercel Blob): a frame overlay or a banner image.
  imageUrl   String?
  /// Uploaded frames: how the picture sits on the avatar, "size,x,y" (lib/frame-fit.ts).
  frameFit   String?
  active     Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  /// When it went on sale (created, or shown again after being hidden): newer
  /// than someone's User.shopSeenAt means "New" to them.
  listedAt   DateTime          @default(now())
  /// Optional Store category (e.g. "Flags"); each category sells as a bundle.
  categoryId String?
  category   CosmeticCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([kind, sortOrder])
  @@index([categoryId])
}

/// A group of Store items of any kind (e.g. "Flags", "Pride"), shown together
/// in the profile shop with a "Buy all" bundle at the plain sum of the prices.
model CosmeticCategory {
  id        String     @id @default(cuid())
  name      String
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  items     Cosmetic[]
}

// ---------- Milestones ----------

model MilestoneRule {
  id     String  @id @default(cuid())
  type   String // "work_anniversary" | "birthday" | "onboarding"
  config Json // anniversaries -> { years: [1,3,5,10] }; onboarding -> { dayOffset: 30 }
  points Int     @default(0)
  active Boolean @default(true)
}

model Celebration {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  occurredOn    DateTime
  recognitionId String? // the auto-post created on the feed
  createdAt     DateTime @default(now())

  @@unique([userId, type, occurredOn]) // idempotency guard for the cron
}

// ---------- Audit (append-only mutation trail) ----------

model AuditEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String? // snapshot at write time
  actorRole   String? // snapshot at write time
  action      String // e.g. recognition.created, reward.archived
  entityType  String
  entityId    String?
  summary     String // human one-liner
  metadata    Json?
  siteId      String? // optional denormalised site scope

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([siteId])
  @@index([entityType, entityId])
}

// ---------- Config ----------

model OrgSettings {
  id                            String  @id @default("singleton")
  appName                       String  @default("Applaud")
  monthlyAllowanceStaff         Int     @default(400)
  monthlyAllowanceManager       Int     @default(1200)
  monthlyAllowanceCentreManager Int     @default(1200)
  monthlyAllowanceOperations    Int     @default(1200)
  monthlyAllowanceCeo           Int     @default(1200)
  /// How many points make one euro (the internal conversion; staff never see euros).
  pointsPerEuro                 Int     @default(100)
  /// Legacy: profile Store price overrides from before the Cosmetic table.
  /// Copied into Cosmetic.price by migration 20261021230000; no longer read.
  cosmeticPrices                Json?
  /// Company-wide cash budget for real rewards per month, in euro cents.
  monthlyRewardBudgetCents      Int     @default(50000)
  /// Most points one recipient can get from a single shout-out (0 = no limit).
  maxPointsPerShoutoutStaff     Int     @default(100)
  maxPointsPerShoutoutManager   Int     @default(300)
  /// Points per month for boosts and approved awards/milestones, outside anyone's allowance.
  monthlyBonusPool              Int     @default(4400)
  /// Legacy, never used: replaced by walletPointsExpireYearEnd.
  pointsExpiryMonths            Int?
  /// Unspent wallet points expire at midnight on 31 Dec, Irish time
  /// (lib/wallet-expiry.ts, run by the year-end and daily crons).
  walletPointsExpireYearEnd     Boolean @default(true)
  allowSelfRecognition          Boolean @default(false)
  /// Create a staff account on the first Google sign-in from the company workspace.
  autoCreateGoogleUsers         Boolean @default(true)
}

// ---------- next-auth (Auth.js Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// An idea from staff for a future reward (kind "reward") or profile shop
/// item (kind "shop"). Others upvote it; admins set where it's up to in
/// Admin > Suggestions. Statuses: "new" | "planned" | "added" | "declined".
model Suggestion {
  id              String           @id @default(cuid())
  kind            String // "reward" | "shop"
  title           String
  details         String?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String           @default("new")
  /// The admin's reply, shown on the idea to everyone.
  adminNote       String?
  /// Cached number of upvotes, written in the same transaction as the vote.
  voteCount       Int              @default(0)
  statusChangedAt DateTime?
  createdAt       DateTime         @default(now())
  votes           SuggestionVote[]

  @@index([kind, status])
}

/// One upvote per person per idea.
model SuggestionVote {
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([suggestionId, userId])
  @@index([userId])
}
