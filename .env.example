# ---------------------------------------------------------------------------
# Yayup environment (example — copy to .env and fill in)
# ---------------------------------------------------------------------------

# Postgres connection string (Neon on Vercel, or any Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# next-auth (Auth.js) v5 — generate with: npx auth secret
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Google Workspace sign-in (the only sign-in on production). Create an OAuth
# client in Google Cloud Console (APIs & Services > Credentials, type "Web
# application") with redirect URI <app URL>/api/auth/callback/google.
# AUTH_GOOGLE_DOMAIN limits sign-in to your workspace (comma-separate several).
# Only users already added in Admin > Users can sign in. Without these, local
# dev and preview deployments still offer the passwordless dev login.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GOOGLE_DOMAIN="leisureworldcork.com"

# Milestone cron — sent as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="change-me"

# Vercel Blob — stores recognition photos/GIFs. Create a Blob store in the
# Vercel dashboard (Storage → Blob) and connect it to the project; Vercel then
# injects this automatically. For local dev, run `vercel env pull` to fetch it.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# GIPHY GIF-library search (optional). Free key at https://developers.giphy.com.
# Omit to disable the composer's GIF search; the rest of the app is unaffected.
GIPHY_API_KEY="change-me"
